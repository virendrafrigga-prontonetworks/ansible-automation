#!/bin/bash
# Waits for this node's tailnet admin approval, then enables TLS-terminated
# TCP Funnel forwarding for a non-HTTP service (e.g. Redis) so it's reachable
# from genuinely external networks/VPCs, not just the tailnet. Mirrors
# enable-funnel.sh's approval-polling pattern.
#
# Uses --tls-terminated-tcp, not plain --tcp: confirmed live that plain --tcp
# mode on this tailnet completes the TCP handshake but never actually relays
# any application data in either direction (matches a known open Tailscale
# issue with --tcp being inconsistent on 443/8443/10000) - Redis's own logs
# showed zero incoming connections even while a client believed it was
# connected. --tls-terminated-tcp (Tailscale terminates TLS at its edge, then
# forwards plain TCP to the backend) was confirmed working end-to-end via a
# real AUTH+PING round trip. The client must connect with TLS even though the
# backend service itself has no TLS of its own (e.g. `redis-cli --tls`).
set -uo pipefail

LOGFILE="/var/log/tailscale-tcp-funnel.log"
exec > >(tee -a "$LOGFILE") 2>&1

FUNNEL_PORT="{{ tcp_funnel_port }}"
LOCAL_PORT="{{ local_port }}"
ERR_FILE="$(mktemp)"

echo "[$(date -Is)] Waiting for tailnet admin approval before enabling TLS-terminated TCP Funnel on port $FUNNEL_PORT -> localhost:$LOCAL_PORT..."

APPROVED=false
for i in {1..2880}; do
    if tailscale funnel --bg --tls-terminated-tcp="$FUNNEL_PORT" "localhost:$LOCAL_PORT" 2>"$ERR_FILE"; then
        APPROVED=true
        break
    fi
    if grep -q "not yet approved" "$ERR_FILE"; then
        sleep 30
        continue
    fi
    # Funnel config is tied to this VM's tailscale identity, not to any one
    # Docker container - a port left in a different mode by an earlier
    # deployment/manual test survives container recreation. Detect that
    # exact conflict and clear it automatically instead of failing, since a
    # human isn't meant to have to intervene here.
    OLD_MODE="$(grep -oP 'is already serving "\K[^"]+' "$ERR_FILE" || true)"
    if [ -n "$OLD_MODE" ]; then
        echo "[$(date -Is)] Port $FUNNEL_PORT was left in '$OLD_MODE' mode by an earlier run - clearing it and retrying..."
        tailscale funnel "--$OLD_MODE=$FUNNEL_PORT" off || true
        continue
    fi
    echo "[$(date -Is)] ERROR: tailscale funnel --tls-terminated-tcp failed for a reason other than pending approval or a mode conflict:"
    cat "$ERR_FILE"
    rm -f "$ERR_FILE"
    exit 1
done
rm -f "$ERR_FILE"

if [ "$APPROVED" != true ]; then
    echo "[$(date -Is)] ERROR: still not approved after 24 hours - giving up. Once approved, run manually:"
    echo "  tailscale funnel --bg --tls-terminated-tcp=$FUNNEL_PORT localhost:$LOCAL_PORT"
    exit 1
fi

echo "[$(date -Is)] TLS-terminated TCP Funnel enabled - reachable (with TLS) at {{ tailscale_hostname }}.<your-tailnet>.ts.net:$FUNNEL_PORT"
