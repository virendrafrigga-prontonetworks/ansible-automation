version: "3.8"

networks:
  web:
    external: true

services:
  traefik:
    # v3.0's Docker provider hardcodes an old Docker API client (v1.24).
    # Docker Engine 29+ raised its minimum supported API version to v1.44,
    # so v3.0 can never talk to the daemon at all (silently discovers zero
    # containers - Traefik itself stays up, just permanently blind). v3.6.1+
    # added automatic API version negotiation, fixing this for good.
    image: traefik:v3.6
    restart: unless-stopped
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - web
