version: "3.8"

networks:
  web:
    external: true

services:
  traefik:
    # v3.0's Docker provider hardcodes an old Docker API client (v1.24).
    # Docker Engine 29+ raised its minimum supported API version to v1.44,
    # so v3.0 can never talk to the daemon at all (silently discovers zero
    # containers - Traefik itself stays up, just permanently blind). v3.6.1+
    # added automatic API version negotiation, fixing this for good.
    image: traefik:v3.6
    restart: unless-stopped
    # No websecure/443 entrypoint - it was never actually used. Tailscale
    # Funnel/Serve already terminates the public HTTPS connection on 443
    # itself and forwards plain HTTP to this VM's port 80 (confirmed
    # earlier: 'tailscale serve --bg 80' proxies public 443 to local 80,
    # not the other way around). Publishing 443 here just collided with
    # tailscaled, which independently binds 443 on its own tailnet IP for
    # its baseline HTTPS cert-serving - confirmed live via a real deploy
    # failure ("address already in use").
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:80"
    ports:
      - "80:80"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - web
