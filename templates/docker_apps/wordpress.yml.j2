version: "3.8"

networks:
  web:
    external: true
  internal:
    external: true

volumes:
  wp_db_data:
  wp_data:

services:
  wordpress_db:
    image: mysql:8.0
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: wordpress
      MYSQL_USER: wordpress
      MYSQL_PASSWORD: "{{ wordpress_db_password }}"
      MYSQL_RANDOM_ROOT_PASSWORD: "yes"
    volumes:
      - wp_db_data:/var/lib/mysql
    networks:
      - internal

  wordpress:
    image: wordpress:latest
    restart: unless-stopped
    depends_on:
      - wordpress_db
    environment:
      WORDPRESS_DB_HOST: wordpress_db
      WORDPRESS_DB_USER: wordpress
      WORDPRESS_DB_PASSWORD: "{{ wordpress_db_password }}"
      WORDPRESS_DB_NAME: wordpress
    volumes:
      - wp_data:/var/www/html
    networks:
      - web
      - internal
    labels:
      - "traefik.enable=true"
{% if path_prefix == '/' %}
      - "traefik.http.routers.wordpress.rule=PathPrefix(`/`)"
{% else %}
      - "traefik.http.routers.wordpress.rule=PathPrefix(`{{ path_prefix }}`)"
      - "traefik.http.middlewares.wordpress-stripprefix.stripprefix.prefixes={{ path_prefix }}"
      - "traefik.http.routers.wordpress.middlewares=wordpress-stripprefix"
{% endif %}
      - "traefik.http.services.wordpress.loadbalancer.server.port=80"
